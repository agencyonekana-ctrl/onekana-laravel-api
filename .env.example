APP_NAME="ONEKANA API"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://api-admin.onekana.com

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=onekana
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4

FRONTEND_URLS=https://onekana.com,https://admin.onekana.com
FRONTEND_APP_URL=https://admin.onekana.com
SYSTEM_API_TOKEN=

ADMIN_EMAIL=
ADMIN_NAME="Admin Onekana"
ADMIN_PASSWORD=

MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@onekana.com
MAIL_FROM_NAME="ONEKANA"

JWT_SECRET=
JWT_TTL=15
JWT_REFRESH_TTL=20160
JWT_AUDIENCE=onekana-business-manager

AGENCY_API_BASE_URL=
AGENCY_API_EMAIL=
AGENCY_API_PASSWORD=
AGENCY_API_TIMEOUT=15
AGENCY_API_CACHE_TTL=30
AGENCY_API_CIRCUIT_SECONDS=60
AGENCY_API_ENABLED=false
AGENCY_API_AUTH_REQUIRED=false
ENABLE_APPROVAL_CENTER=false

ENABLE_GEOGRAPHY=true
ENABLE_ADVANCED_FINANCE=false

# Sauvegarde quotidienne (variables du cron uniquement, pas du site web)
BACKUP_DIR=
BACKUP_ENCRYPTION_KEY=
